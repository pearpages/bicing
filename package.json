{
  "name": "bicing-pulse",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @bicing/web dev",
    "build": "pnpm --filter @bicing/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest",
    "synth": "pnpm --filter @bicing/tool-synthetic synth",
    "prepare-data": "pnpm --filter @bicing/tool-prepare-data prepare-data",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1"
  }
}
